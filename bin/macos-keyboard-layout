#!/usr/bin/env bash
# Keyboard layout manager for the macOS-style keyboard toggle plugin.
#
# State JSON is the source of truth; a Lua toggle file is generated for
# Omarchy's user-toggle loader. Safe-apply flow (validate -> pause
# autoreload -> atomic writes -> rollback) adapted from
# NOmarkOO/omarchy-keyboard-languages (MIT):
# https://github.com/NOmarkOO/omarchy-keyboard-languages

set -euo pipefail

state_root=${XDG_STATE_HOME:-$HOME/.local/state}
state_dir=$state_root/omarchy/settings
state_file=${SMYRNODE_KB_STATE_FILE:-$state_dir/smyrnode-macos-keyboard-toggle.json}
toggle_dir=$state_root/omarchy/toggles/hypr
toggle_file=${SMYRNODE_KB_TOGGLE_FILE:-$toggle_dir/smyrnode-macos-keyboard-toggle.lua}
lock_file=$state_dir/smyrnode-macos-keyboard-toggle.lock
bindings_file=${SMYRNODE_KB_BINDINGS_FILE:-${HOME}/.config/hypr/bindings.lua}

usage() {
  printf '%s\n' \
    'Usage: macos-keyboard-layout status' \
    '       macos-keyboard-layout available' \
    '       macos-keyboard-layout set INDEX' \
    '       macos-keyboard-layout add LAYOUT [VARIANT]' \
    '       macos-keyboard-layout remove INDEX' \
    '       macos-keyboard-layout move INDEX up|down' \
    '       macos-keyboard-layout alias INDEX [VALUE]' \
    '       macos-keyboard-layout shortcut XKB_GRP_OPTION' \
    '       macos-keyboard-layout hotkey COMBO' \
    '       macos-keyboard-layout mode mru|xkb' \
    '       macos-keyboard-layout reapply' \
    '       macos-keyboard-layout snapshot-current' \
    '       macos-keyboard-layout current-index' >&2
  exit 2
}

die() {
  printf '%s\n' "$1" >&2
  exit 1
}

ensure_dirs() {
  mkdir -p -- "$state_dir" "$toggle_dir"
}

validate_shape() {
  jq -e '
    .version == 1 and
    (.switchMode == "mru" or .switchMode == "xkb") and
    (.layouts | type == "array" and length > 0) and
    (all(.layouts[];
      (.layout | type == "string" and test("^[A-Za-z0-9_+-]+$")) and
      (.variant | type == "string" and test("^[A-Za-z0-9_+-]*$")) and
      (
        (has("alias") | not) or
        (
          ((.alias | type) == "string") and
          ((.alias | length) <= 6) and
          (.alias | explode | all(.[]; . >= 32 and (. < 127 or . > 159)))
        )
      )
    )) and
    ([.layouts[] | [.layout, .variant]] | unique | length) == (.layouts | length) and
    (.switchOption | type == "string" and test("^grp:[A-Za-z0-9_+-]+$")) and
    (
      (has("hotkey") | not) or
      (.hotkey | type == "string" and test("^[A-Z0-9_+ ]+$"))
    ) and
    (.nonGroupOptions | type == "array") and
    (all(.nonGroupOptions[]; type == "string" and test("^[A-Za-z0-9_:+-]+$") and (startswith("grp:") | not)))
  ' >/dev/null 2>&1 <<<"$1"
}

layout_csv() { jq -r '[.layouts[].layout] | join(",")' <<<"$1"; }
variant_csv() { jq -r '[.layouts[].variant] | join(",")' <<<"$1"; }

# The options that actually reach the keymap: the group shortcut is only
# active in xkb mode, so the MRU script owns the hotkey without a second
# switcher living in the keymap.
keymap_options() {
  if [[ $(jq -r '.switchMode' <<<"$1") == xkb ]]; then
    jq -r '[.nonGroupOptions[], .switchOption] | map(select(length > 0)) | join(",")' <<<"$1"
  else
    jq -r '[.nonGroupOptions[]] | map(select(length > 0)) | join(",")' <<<"$1"
  fi
}

normalize_hotkey() {
  local combo=$1
  printf '%s' "$combo" | tr '[:lower:]' '[:upper:]' | sed -E 's/[[:space:]]*\+[[:space:]]*/ + /g; s/^[[:space:]]+//; s/[[:space:]]+$//'
}

validate_hotkey() {
  local combo=$1 key
  [[ $combo =~ ^(SUPER|CTRL|ALT|SHIFT)([[:space:]]+\+[[:space:]]+(SUPER|CTRL|ALT|SHIFT))*([[:space:]]+\+[[:space:]]+[A-Z0-9_]+)$ ]] || return 1
  key=${combo##*+ }
  [[ $key =~ ^(SUPER|CTRL|ALT|SHIFT)$ ]] && return 1
  return 0
}

read_bound_hotkey() {
  sed -nE 's/^o\.bind\("([^"]+)".*omarchy-lang-toggle.*/\1/p' "$bindings_file" 2>/dev/null | head -n1
}

write_binding() {
  local combo=$1 temp
  [[ -f $bindings_file ]] || die "Bindings file $bindings_file not found; nothing was changed."
  temp=$(mktemp --tmpdir="$(dirname "$bindings_file")" .smyrnode-kb-bind.XXXXXX)
  sed '/omarchy-lang-toggle/d; /macOS-style language toggle/d' "$bindings_file" >"$temp"
  while [[ -s $temp && -z $(tail -n1 "$temp") ]]; do
    sed -i '$d' "$temp"
  done
  printf '\n-- macOS-style language toggle: quick tap toggles last 2, rapid taps cycle all\n' >>"$temp"
  printf 'o.bind("%s", "Toggle language (macOS-style)", "~/.local/bin/omarchy-lang-toggle")\n' "$combo" >>"$temp"
  mv -f -- "$temp" "$bindings_file"
}

hypr_option_string() {
  local option=$1 payload
  payload=$(hyprctl -j getoption "$option" 2>/dev/null) || return 1
  jq -er '
    if (.str? | type) == "string" then .str
    elif (.string? | type) == "string" then .string
    else empty
    end
  ' <<<"$payload"
}

snapshot_current() {
  command -v hyprctl >/dev/null 2>&1 \
    || die 'No saved keyboard settings exist and hyprctl is unavailable. Run the installer inside a live Omarchy session.'
  hyprctl -j devices >/dev/null 2>&1 \
    || die 'No saved keyboard settings exist and no live Hyprland session is reachable. Run the installer from your Omarchy desktop.'

  local layouts variants options payload
  layouts=$(hypr_option_string input:kb_layout) \
    || die 'The current Hyprland keyboard layouts could not be read; nothing was changed.'
  variants=$(hypr_option_string input:kb_variant 2>/dev/null || printf '')
  options=$(hypr_option_string input:kb_options 2>/dev/null || printf '')
  [[ -n $layouts ]] || die 'Hyprland did not report an active keyboard layout; nothing was changed.'

  payload=$(jq -cn \
    --arg layouts "$layouts" \
    --arg variants "$variants" \
    --arg options "$options" \
    --arg hotkey "$(read_bound_hotkey)" '
      ($layouts | split(",")) as $layoutList
      | ($variants | split(",")) as $variantList
      | ($options | split(",") | map(select(length > 0))) as $optionList
      | {
          version: 1,
          switchMode: "mru",
          layouts: [$layoutList | to_entries[] | {
            layout: .value,
            variant: ($variantList[.key] // "")
          }],
          switchOption: ([$optionList[] | select(startswith("grp:"))][-1] // "grp:ctrl_space_toggle"),
          nonGroupOptions: [$optionList[] | select(startswith("grp:") | not)],
          hotkey: (if $hotkey == "" then "CTRL + SPACE" else $hotkey end)
        }
    ')
  validate_candidate "$payload"
  jq . <<<"$payload"
}

compile_layout() {
  local payload=$1
  xkbcli compile-keymap \
    --layout "$(layout_csv "$payload")" \
    --variant "$(variant_csv "$payload")" \
    --options "$(keymap_options "$payload")" >/dev/null 2>&1
}

is_latin() {
  local layout=$1 variant=${2:-} command letters
  command=(xkbcli compile-keymap --layout "$layout")
  [[ -z $variant ]] || command+=(--variant "$variant")
  letters=$("${command[@]}" 2>/dev/null \
    | sed -nE 's/.*\{[[:space:]]*\[[[:space:]]*([a-z])[[:space:]]*,.*/\1/p' \
    | sort -u \
    | tr -d '\n')
  [[ ${#letters} -eq 26 ]]
}

validate_candidate() {
  local payload=$1 first_layout first_variant shortcut catalog option
  validate_shape "$payload" || die 'Invalid keyboard-layout state; nothing was changed.'
  shortcut=$(jq -r '.switchOption' <<<"$payload")
  if [[ $shortcut =~ _switch(_|$) ]] \
    || [[ $shortcut != grp:toggle && ! $shortcut =~ _toggle(_|$) && ! $shortcut =~ _select$ ]]; then
    die 'Choose a supported XKB layout-switching shortcut; nothing was changed.'
  fi
  catalog=$(xkbcli list --load-exotic 2>/dev/null) || die 'The installed XKB catalog could not be read; nothing was changed.'
  while IFS= read -r option; do
    [[ -z $option ]] && continue
    grep -Fqx "  - name: '$option'" <<<"$catalog" \
      || die "XKB does not provide option '$option'; nothing was changed."
  done < <(jq -r '.nonGroupOptions[], .switchOption' <<<"$payload")
  compile_layout "$payload" || die 'XKB rejected that layout, variant, or shortcut; nothing was changed.'
  first_layout=$(jq -r '.layouts[0].layout' <<<"$payload")
  first_variant=$(jq -r '.layouts[0].variant' <<<"$payload")
  is_latin "$first_layout" "$first_variant" || die "Keep a Latin layout first so SUPER+letter shortcuts continue to work."
}

render_toggle() {
  local payload=$1 target=$2
  printf '%s\n' \
    '-- Generated by smyrnode.macos-keyboard-toggle. Use the bar panel to edit this file.' \
    'hl.config({' \
    '  input = {' \
    "    kb_layout = \"$(layout_csv "$payload")\"," \
    "    kb_variant = \"$(variant_csv "$payload")\"," \
    "    kb_options = \"$(keymap_options "$payload")\"," \
    '  },' \
    '})' >"$target"
  chmod 0644 "$target"
}

typed_keyboard_names() {
  hyprctl -j devices 2>/dev/null | jq -r '
    .keyboards[]?.name
    | select(ascii_downcase
        | test("consumer|system|virtual|fcitx|power-button|sleep-button|lid-switch|video-bus|avrcp") | not)
  '
}

all_keyboard_names() {
  hyprctl -j devices 2>/dev/null | jq -r '.keyboards[]?.name'
}

active_index() {
  local index
  index=$(hyprctl -j devices 2>/dev/null | jq -r '
    [.keyboards[]?
      | select((.name | ascii_downcase
          | test("consumer|system|virtual|fcitx|power-button|sleep-button|lid-switch|video-bus|avrcp")) | not)
      | (.active_layout_index // 0)]
    | max // 0
  ' 2>/dev/null || true)
  [[ $index =~ ^[0-9]+$ ]] && printf '%s\n' "$index" || printf '0\n'
}

switch_all() {
  local index=$1 keyboard code
  command -v hyprctl >/dev/null 2>&1 || return 0
  while IFS= read -r keyboard; do
    [[ -z $keyboard ]] || hyprctl switchxkblayout "$keyboard" "$index" >/dev/null 2>&1 || true
  done < <(typed_keyboard_names || true)
  # fcitx5 keyboard-* input methods map keysyms themselves (its virtual
  # keyboard is often the seat's main keyboard), so typing ignores XKB group
  # switches. Sync its input method or the indicator moves but typing does not.
  code=$(jq -r --argjson i "$index" '.layouts[$i].layout // empty' "$state_file" 2>/dev/null || true)
  [[ -n $code ]] && sync_fcitx "$code"
  return 0
}

sync_fcitx() {
  local code=$1
  command -v fcitx5-remote >/dev/null 2>&1 || return 0
  fcitx5-remote -s "keyboard-$code" >/dev/null 2>&1 || true
}

# A keymap swap right before switching can make switchxkblayout land on the
# outgoing map, so retry until the seat reports the requested index.
switch_all_reliable() {
  local index=$1 attempt
  for attempt in 1 2 3 4 5 6 7 8; do
    switch_all "$index"
    [[ $(active_index) == "$index" ]] && return 0
    sleep 0.05
  done
  return 0
}

switch_all_keyboards_checked() {
  local index=$1 keyboard
  local -a keyboards=()
  command -v hyprctl >/dev/null 2>&1 || return 1
  mapfile -t keyboards < <(all_keyboard_names)
  ((${#keyboards[@]} > 0)) || return 1
  for keyboard in "${keyboards[@]}"; do
    hyprctl switchxkblayout "$keyboard" "$index" >/dev/null 2>&1 || return 1
  done
}

disable_autoreload_value() {
  hyprctl -j getoption misc:disable_autoreload 2>/dev/null \
    | jq -er '.bool | if . then "true" else "false" end' 2>/dev/null
}

set_disable_autoreload() {
  local value=$1
  hyprctl eval "hl.config({ misc = { disable_autoreload = $value } })" >/dev/null 2>&1
}

apply_live_config() {
  local payload=$1 layouts variants options
  layouts=$(layout_csv "$payload")
  variants=$(variant_csv "$payload")
  options=$(keymap_options "$payload")
  hyprctl eval "hl.config({ input = { kb_layout = \"$layouts\", kb_variant = \"$variants\", kb_options = \"$options\" } })" >/dev/null 2>&1
}

status_json() {
  local payload latins='[]' layout variant latin group_option
  payload=$(jq -c . "$state_file")
  while IFS=$'\t' read -r layout variant; do
    if is_latin "$layout" "$variant"; then latin=true; else latin=false; fi
    latins=$(jq -c --argjson value "$latin" '. + [$value]' <<<"$latins")
  done < <(jq -r '.layouts[] | [.layout, .variant] | @tsv' <<<"$payload")
  group_option=$(hypr_option_string input:kb_options 2>/dev/null \
    | jq -Rr 'split(",") | map(select(startswith("grp:"))) | if length > 0 then .[-1] else empty end' 2>/dev/null || true)
  jq -c --argjson latins "$latins" --argjson activeIndex "$(active_index)" --arg groupOption "${group_option:-}" '
    .layouts |= to_entries | .layouts |= map(.value + {latin: $latins[.key]})
    | .activeIndex = $activeIndex
    | .groupOption = $groupOption
  ' <<<"$payload"
}

rollback_files() {
  local old_state=$1 old_toggle=$2 had_state=$3 had_toggle=$4
  if [[ $had_state == true ]]; then cp -p -- "$old_state" "$state_file"; else rm -f -- "$state_file"; fi
  if [[ $had_toggle == true ]]; then cp -p -- "$old_toggle" "$toggle_file"; else rm -f -- "$toggle_file"; fi
}

commit_candidate() {
  local payload=$1 requested_index=${2:-0} pre_apply_index=${3:-} rollback_index=${4:-0} force=${5:-false}
  local temp_state temp_toggle old_state old_toggle old_payload=""
  local had_state=false had_toggle=false live=false reload_guarded=false reload_was_disabled=""

  restore_reload_guard() {
    if [[ $live == true && $reload_guarded == true ]]; then
      set_disable_autoreload "$reload_was_disabled" || true
      reload_guarded=false
    fi
  }

  validate_candidate "$payload"
  ensure_dirs
  temp_state=$(mktemp --tmpdir="$state_dir" .smyrnode-kb-state.XXXXXX)
  temp_toggle=$(mktemp --tmpdir="$toggle_dir" .smyrnode-kb-toggle.XXXXXX)
  old_state=$(mktemp --tmpdir="$state_dir" .smyrnode-kb-old-state.XXXXXX)
  old_toggle=$(mktemp --tmpdir="$toggle_dir" .smyrnode-kb-old-toggle.XXXXXX)

  jq . <<<"$payload" >"$temp_state"
  chmod 0644 "$temp_state"
  render_toggle "$payload" "$temp_toggle"

  if [[ $force != true ]]; then
    # Installing an already active revision must be a true no-op. Reapplying an
    # unchanged XKB keymap still makes Hyprland replace keymap file descriptors,
    # which is needless work and has exposed compositor bugs on live sessions.
    if [[ -f $state_file && -f $toggle_file ]] \
      && [[ "$(jq -S -c . "$state_file")" == "$(jq -S -c . <<<"$payload")" ]] \
      && cmp -s -- "$temp_toggle" "$toggle_file"; then
      rm -f -- "$temp_state" "$temp_toggle" "$old_state" "$old_toggle"
      status_json
      return 0
    fi

    # Metadata-only revision (e.g. switching the XKB shortcut while MRU mode
    # owns the key): the generated keymap is unchanged, so do not reapply it.
    if [[ -f $toggle_file ]] && cmp -s -- "$temp_toggle" "$toggle_file"; then
      mv -f -- "$temp_state" "$state_file"
      rm -f -- "$temp_toggle" "$old_state" "$old_toggle"
      status_json
      return 0
    fi
  fi

  if [[ -f $state_file ]]; then
    cp -p -- "$state_file" "$old_state"
    old_payload=$(jq -c . "$old_state")
    had_state=true
  fi
  if [[ -f $toggle_file ]]; then cp -p -- "$toggle_file" "$old_toggle"; had_toggle=true; fi
  if command -v hyprctl >/dev/null 2>&1 && hyprctl -j devices >/dev/null 2>&1; then live=true; fi

  if [[ $live == true ]]; then
    reload_was_disabled=$(disable_autoreload_value) \
      || die 'Hyprland autoreload state could not be read; nothing was changed.'
    set_disable_autoreload true \
      || die 'Hyprland autoreload could not be paused safely; nothing was changed.'
    reload_guarded=true
    trap restore_reload_guard EXIT
    trap 'restore_reload_guard; exit 129' HUP
    trap 'restore_reload_guard; exit 130' INT
    trap 'restore_reload_guard; exit 143' TERM

    # Shrinking kb_layout changes indices. Move every Hyprland keyboard,
    # including virtual keyboards and button devices, to an old index that also
    # exists in the candidate before replacing the keymap. Leaving even an
    # auxiliary device on a removed index can make Hyprland marshal a vanished
    # keymap.
    if [[ -n $pre_apply_index ]] && ! switch_all_keyboards_checked "$pre_apply_index"; then
      restore_reload_guard
      trap - EXIT HUP INT TERM
      rm -f -- "$temp_state" "$temp_toggle" "$old_state" "$old_toggle"
      die 'The keyboards could not be moved to a safe layout; nothing was changed.'
    fi
  fi

  mv -f -- "$temp_state" "$state_file"
  mv -f -- "$temp_toggle" "$toggle_file"

  if [[ $live == true ]]; then
    if ! apply_live_config "$payload"; then
      rollback_files "$old_state" "$old_toggle" "$had_state" "$had_toggle"
      [[ -z $old_payload ]] || apply_live_config "$old_payload" || true
      [[ -z $pre_apply_index ]] || switch_all "$rollback_index"
      restore_reload_guard
      trap - EXIT HUP INT TERM
      rm -f -- "$temp_state" "$temp_toggle" "$old_state" "$old_toggle"
      die 'Hyprland rejected the keyboard configuration; the previous settings were restored without reloading the session.'
    fi
    switch_all_reliable "$requested_index"
    restore_reload_guard
    trap - EXIT HUP INT TERM
  fi

  rm -f -- "$temp_state" "$temp_toggle" "$old_state" "$old_toggle"
  status_json
}

commit_metadata_candidate() {
  local payload=$1 temp_state
  validate_shape "$payload" || die 'Invalid keyboard-layout state; nothing was changed.'
  ensure_dirs
  temp_state=$(mktemp --tmpdir="$state_dir" .smyrnode-kb-state.XXXXXX)
  jq . <<<"$payload" >"$temp_state"
  chmod 0644 "$temp_state"
  if [[ -f $state_file ]] \
    && [[ "$(jq -S -c . "$temp_state")" == "$(jq -S -c . "$state_file")" ]]; then
    rm -f -- "$temp_state"
  else
    mv -f -- "$temp_state" "$state_file"
  fi
  status_json
}

ensure_state() {
  ensure_dirs
  [[ -f $state_file ]] && return 0
  local initial
  initial=$(snapshot_current)
  commit_candidate "$initial" "$(active_index)" >/dev/null
}

action=${1:-status}
case "$action" in
  current-index)
    active_index
    ;;
  snapshot-current)
    snapshot_current
    ;;
  available)
    xkbcli list --load-exotic
    ;;
  status)
    ensure_state
    status_json
    ;;
  set)
    [[ ${2:-} =~ ^[0-9]+$ ]] || usage
    index=$2
    ensure_state
    count=$(jq '.layouts | length' "$state_file")
    (( index < count )) || die 'That keyboard language is no longer available.'
    switch_all_reliable "$index"
    status_json
    ;;
  add)
    layout=${2:-}; variant=${3:-}
    [[ $layout =~ ^[A-Za-z0-9_+-]+$ && $variant =~ ^[A-Za-z0-9_+-]*$ ]] || usage
    ensure_state
    exec 9>"$lock_file"
    flock -x 9
    payload=$(jq -c --arg layout "$layout" --arg variant "$variant" '
      if any(.layouts[]; .layout == $layout and .variant == $variant)
      then error("duplicate")
      else .layouts += [{layout: $layout, variant: $variant}]
      end
    ' "$state_file" 2>/dev/null) || die 'That language and variant is already available.'
    commit_candidate "$payload" "$(jq '.layouts | length' "$state_file")"
    ;;
  remove)
    [[ ${2:-} =~ ^[0-9]+$ ]] || usage
    index=$2
    ensure_state
    exec 9>"$lock_file"
    flock -x 9
    count=$(jq '.layouts | length' "$state_file")
    (( count > 1 )) || die 'Keep at least one keyboard language.'
    (( index < count )) || die 'That keyboard language is no longer available.'
    current=$(active_index)
    if (( index < current )); then next=$((current - 1)); elif (( index == current )); then next=$index; else next=$current; fi
    (( next < count - 1 )) || next=$((count - 2))
    # Index zero normally survives. If zero itself is removed, index one is the
    # first guaranteed survivor and becomes index zero in the candidate.
    if (( index == 0 )); then safe_old_index=1; else safe_old_index=0; fi
    payload=$(jq -c --argjson index "$index" '.layouts |= del(.[$index])' "$state_file")
    commit_candidate "$payload" "$next" "$safe_old_index" "$current"
    ;;
  move)
    [[ ${2:-} =~ ^[0-9]+$ ]] || usage
    index=$2
    dir=${3:-}
    [[ $dir == up || $dir == down ]] || usage
    ensure_state
    exec 9>"$lock_file"
    flock -x 9
    count=$(jq '.layouts | length' "$state_file")
    (( index < count )) || die 'That keyboard language is no longer available.'
    if [[ $dir == up ]]; then
      target=$((index - 1))
      (( target >= 0 )) || die 'That language is already first.'
    else
      target=$((index + 1))
      (( target < count )) || die 'That language is already last.'
    fi
    # Keep the language someone is typing on active across the reorder.
    current=$(active_index)
    if (( current == index )); then requested=$target
    elif (( current == target )); then requested=$index
    else requested=$current; fi
    payload=$(jq -c --argjson i "$index" --argjson j "$target" '
      .layouts[$i] as $a | .layouts[$j] as $b | .layouts[$i] = $b | .layouts[$j] = $a
    ' "$state_file")
    commit_candidate "$payload" "$requested"
    ;;
  reapply)
    ensure_state
    exec 9>"$lock_file"
    flock -x 9
    commit_candidate "$(jq -c . "$state_file")" "$(active_index)" "" "" true
    ;;
  alias)
    [[ ${2:-} =~ ^[0-9]+$ ]] || usage
    index=$2
    value=${3:-}
    jq -en --arg value "$value" '
      ($value | explode | all(.[]; . >= 32 and (. < 127 or . > 159))) and
      ($value | gsub("^\\s+|\\s+$"; "") | length <= 6)
    ' >/dev/null || die 'Use up to 6 printable characters for the bar alias; nothing was changed.'
    alias=$(jq -nr --arg value "$value" '$value | gsub("^\\s+|\\s+$"; "")')
    ensure_state
    exec 9>"$lock_file"
    flock -x 9
    count=$(jq '.layouts | length' "$state_file")
    (( index < count )) || die 'That keyboard language is no longer available.'
    payload=$(jq -c --argjson index "$index" --arg alias "$alias" '
      if $alias == "" then del(.layouts[$index].alias)
      else .layouts[$index].alias = $alias
      end
    ' "$state_file")
    commit_metadata_candidate "$payload"
    ;;
  shortcut)
    shortcut=${2:-}
    [[ $shortcut =~ ^grp:[A-Za-z0-9_+-]+$ ]] || usage
    ensure_state
    exec 9>"$lock_file"
    flock -x 9
    payload=$(jq -c --arg shortcut "$shortcut" '.switchOption = $shortcut' "$state_file")
    commit_candidate "$payload" "$(active_index)"
    ;;
  hotkey)
    combo=$(normalize_hotkey "${2:-}")
    validate_hotkey "$combo" || die 'Use a key combination like "CTRL + SPACE" or "SUPER + SHIFT + S"; nothing was changed.'
    ensure_state
    exec 9>"$lock_file"
    flock -x 9
    payload=$(jq -c --arg hotkey "$combo" '.hotkey = $hotkey' "$state_file")
    commit_metadata_candidate "$payload"
    write_binding "$combo"
    hyprctl reload >/dev/null 2>&1 || true
    ;;
  mode)
    mode=${2:-}
    [[ $mode == mru || $mode == xkb ]] || usage
    ensure_state
    exec 9>"$lock_file"
    flock -x 9
    payload=$(jq -c --arg mode "$mode" '.switchMode = $mode' "$state_file")
    commit_candidate "$payload" "$(active_index)"
    ;;
  *)
    usage
    ;;
esac

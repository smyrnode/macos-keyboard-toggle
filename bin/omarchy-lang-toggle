#!/usr/bin/env python3
"""
macOS-style keyboard layout switcher for Omarchy / Hyprland.
- Normal press (single tap): toggles between the last TWO used layouts.
- Rapid / hold press (within CYCLE_TIMEOUT_MS): cycles through all available layouts.
- Works dynamically with ANY layouts configured in Hyprland (zero hardcoding).
"""

import json
import os
import subprocess
import time

STATE_FILE = os.path.expanduser("~/.cache/omarchy-lang-toggle.json")
CYCLE_TIMEOUT_MS = 1000  # 1 second window to continue cycling


def get_configured_layouts():
    """Get list of configured layouts from Hyprland options."""
    try:
        out = subprocess.check_output(
            ["hyprctl", "getoption", "input:kb_layout", "-j"],
            stderr=subprocess.DEVNULL,
        )
        data = json.loads(out)
        raw = data.get("str", "")
        layouts = [l.strip() for l in raw.split(",") if l.strip()]
        if layouts:
            return layouts
    except Exception:
        pass
    return ["us"]


def get_hyprland_devices():
    """Get all connected devices from Hyprland."""
    try:
        out = subprocess.check_output(
            ["hyprctl", "devices", "-j"], stderr=subprocess.DEVNULL
        )
        return json.loads(out)
    except Exception:
        return {}


def is_typed_keyboard(name):
    """Filter out non-typing virtual devices, buttons, switches."""
    n = name.lower()
    return not (
        "consumer" in n
        or "system" in n
        or "-1" in n
        or "virtual" in n
        or "fcitx" in n
        or "power-button" in n
        or "sleep-button" in n
        or "lid-switch" in n
        or "video-bus" in n
    )


def get_active_keyboard_info(devices, num_layouts):
    """Find the main typed keyboard, its active layout index, and keymap name."""
    keyboards = devices.get("keyboards", [])
    typed_kbs = [kb for kb in keyboards if is_typed_keyboard(kb.get("name", ""))]
    target_kb = typed_kbs[0] if typed_kbs else (keyboards[0] if keyboards else {})

    idx = target_kb.get("active_layout_index", 0)
    keymap = target_kb.get("active_keymap", "")

    # Ensure index is within range
    if not isinstance(idx, int) or idx < 0 or idx >= num_layouts:
        idx = 0

    return idx, keymap


def apply_layout_to_all(devices, target_idx):
    """Switch layout for all real keyboards."""
    keyboards = devices.get("keyboards", [])
    target_str = str(target_idx)
    for kb in keyboards:
        name = kb.get("name", "")
        if name:
            subprocess.run(
                ["hyprctl", "switchxkblayout", name, target_str],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )


COMMON_NAMES = {
    "us": "English",
    "en": "English",
    "ru": "Русский",
    "gr": "Ελληνικά",
    "el": "Ελληνικά",
    "ua": "Українська",
    "uk": "Українська",
    "by": "Беларуская",
    "de": "Deutsch",
    "fr": "Français",
    "es": "Español",
    "it": "Italiano",
    "pt": "Português",
    "pl": "Polski",
    "cz": "Čeština",
    "sk": "Slovenčina",
    "bg": "Български",
    "rs": "Српски",
    "tr": "Türkçe",
    "ja": "日本語",
    "zh": "中文",
    "ko": "한국어",
    "ar": "العربية",
    "he": "עברית",
}


def show_switcher_hud(target_idx, configured_layouts, updated_keymap):
    """Show macOS-style card switcher HUD via Omarchy Shell IPC."""
    names = []
    for idx, code in enumerate(configured_layouts):
        c = code.lower().strip()
        if idx == target_idx and updated_keymap:
            clean_k = updated_keymap.split(", with")[0].split("(")[0].strip()
            names.append(clean_k if clean_k else COMMON_NAMES.get(c, code.upper()))
        elif c in COMMON_NAMES:
            names.append(COMMON_NAMES[c])
        else:
            names.append(code.upper())

    payload = json.dumps({
        "activeIndex": target_idx,
        "layouts": [c.upper() for c in configured_layouts],
        "names": names,
    })

    try:
        subprocess.Popen(
            ["omarchy-shell", "-q", "macos-keyboard-toggle", "showHud", payload],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


def show_osd(layout_name):
    """Display Omarchy OSD notification with the active layout name."""
    if not layout_name:
        return
    # Clean up verbose technical suffixes like ", with dead keys"
    clean_name = layout_name.split(", with")[0].strip()
    try:
        subprocess.Popen(
            ["omarchy", "osd", "-i", "input-keyboard", "-m", clean_name],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


def main():
    configured_layouts = get_configured_layouts()
    num_layouts = len(configured_layouts)

    if num_layouts < 2:
        # Nothing to switch between if there is only 1 layout
        return

    devices = get_hyprland_devices()
    current_idx, _ = get_active_keyboard_info(devices, num_layouts)
    now_ms = int(time.time() * 1000)

    # Default state: [current, previous]
    default_prev = 1 if current_idx == 0 else 0
    mru = [current_idx, default_prev]
    origin = current_idx
    last_ts = 0

    if os.path.exists(STATE_FILE):
        try:
            with open(STATE_FILE, "r") as f:
                saved = json.load(f)
                saved_mru = saved.get("mru", [])
                if (
                    len(saved_mru) == 2
                    and saved_mru[0] != saved_mru[1]
                    and all(isinstance(x, int) and 0 <= x < num_layouts for x in saved_mru)
                ):
                    mru = saved_mru
                origin = saved.get("origin", mru[0])
                last_ts = saved.get("last_ts", 0)
        except Exception:
            pass

    # Resync MRU if active layout was changed externally
    if mru[0] != current_idx:
        mru = [current_idx, mru[0]]

    elapsed = now_ms - last_ts
    is_cycling = False

    if elapsed > CYCLE_TIMEOUT_MS:
        # NORMAL TAP: Swap current and previous (MRU toggle)
        origin = mru[0]
        mru = [mru[1], mru[0]]
        is_cycling = False
    else:
        # CYCLING: Rapid press within timeout -> cycle through remaining layouts
        is_cycling = True
        next_layout = (mru[0] + 1) % num_layouts
        last_current = mru[0]
        if next_layout != origin:
            mru = [next_layout, origin]
        else:
            mru = [next_layout, last_current]

    # Safety guarantee: mru[0] and mru[1] are never identical
    if mru[0] == mru[1]:
        mru[1] = (mru[0] + 1) % num_layouts

    target = mru[0]

    # Save state
    new_state = {
        "mru": mru,
        "origin": origin,
        "last_ts": now_ms,
    }
    try:
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        with open(STATE_FILE, "w") as f:
            json.dump(new_state, f)
    except Exception:
        pass

    # Switch all keyboards
    apply_layout_to_all(devices, target)

    # Show macOS switcher HUD only when cycling through layouts (3+ layouts), never on normal toggle
    if num_layouts > 2 and is_cycling:
        updated_devices = get_hyprland_devices()
        _, updated_keymap = get_active_keyboard_info(updated_devices, num_layouts)
        show_switcher_hud(target, configured_layouts, updated_keymap)


if __name__ == "__main__":
    main()
